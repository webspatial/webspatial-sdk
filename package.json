{
  "name": "webspatial-sdk",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "simple-git-hooks",
    "buildPackages": "pnpm -r --filter \"@webspatial/*\" run build",
    "setup": "pnpm install && npm run buildPackages",
    "watchNPM": "concurrently \"cd packages/core/ && npm run start\" \"cd packages/react/ && npm run start\"",
    "testServer": "cd apps/test-server/ && npm run dev -- --host",
    "dev": "npm run testServer",
    "xcode": "open packages/visionOS/web-spatial.xcodeproj",
    "adbDevPorts": "adb reverse tcp:35729 tcp:35729 && adb reverse tcp:5173 tcp:5173",
    "test": "concurrently \"pnpm -r --filter '@webspatial/*' run test\" \"tsc -p apps/test-server/tsconfig.json\" \"pnpm run test:workflows\" \"pnpm run test:runtime-capabilities\"",
    "check:unused": "node tools/scripts/check-unused-locals.js",
    "codeql:js": "node tools/scripts/run-codeql-js.js",
    "test:workflows": "node tools/scripts/check-release-workflows.js",
    "generate:runtime-capabilities": "node tools/scripts/generate-runtime-capability-manifest.js",
    "test:runtime-capabilities": "node tools/scripts/generate-runtime-capability-manifest.js --check",
    "test:react-compat": "pnpm --filter react18-compat test && pnpm --filter react19-compat test",
    "test:rspack-compat": "pnpm --filter spatial-rspack-min --fail-if-no-match build",
    "test:fixtures": "pnpm --filter spatial-vite-min --fail-if-no-match build && pnpm --filter spatial-next-min --fail-if-no-match build && pnpm --filter spatial-next-eager-min --fail-if-no-match build && pnpm --filter spatial-remix-min --fail-if-no-match build && pnpm run test:rspack-compat",
    "test:auto": "cd tests/autoTest/ && pnpm run test",
    "test:auto:setup-local": "cd tests/autoTest/ && pnpm run setup-local",
    "test:size-budget": "pnpm --filter @webspatial/react-sdk build && pnpm --filter marginal-delta-vite test",
    "ciTest": "cd tests/ci-test/ && pnpm run test",
    "format": "pnpm -r run format",
    "ci:publish": "changeset publish",
    "changeset": "changeset",
    "changeset:pre-enter": "changeset pre enter alpha",
    "changeset:pre-exit": "changeset pre exit alpha",
    "generateStaticSite": "./tools/scripts/generateWebsite.sh"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=9"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "prettier --write"
    ],
    "*.swift": [
      "swiftformat"
    ],
    "*": [
      "node ./tools/scripts/check-filesize.js",
      "node ./tools/scripts/check-valid-characters.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webspatial/webspatial-sdk.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/webspatial/webspatial-sdk/issues"
  },
  "homepage": "https://github.com/webspatial/webspatial-sdk#readme",
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "@fission-ai/openspec": "^1.4.0",
    "@vitest/coverage-v8": "^4.1.8",
    "concurrently": "^8.2.2",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "simple-git-hooks": "^2.11.1",
    "typescript": "^5.7.3",
    "vite": "6.4.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "prismjs@<1.30.0": ">=1.30.0",
      "ip-address@<=10.1.0": ">=10.1.1",
      "path-to-regexp@<0.1.13": "0.1.13",
      "serialize-javascript@<7.0.5": ">=7.0.5",
      "postcss@<8.5.10": ">=8.5.10",
      "qs@<6.14.2": ">=6.14.2",
      "@eslint/plugin-kit@<0.3.4": ">=0.3.4",
      "uuid@<11.1.1": "11.1.1",
      "tmp@<0.2.6": ">=0.2.6"
    }
  }
}
