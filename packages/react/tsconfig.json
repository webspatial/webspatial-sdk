{
  "compilerOptions": {
    "target": "ES2025",
    "useDefineForClassFields": true,
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "allowJs": false,
    /* Bundler mode */
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": false,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    // TypeScript 6 requires this explicitly because path aliases include ../core/src.
    "rootDir": "..",
    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "outDir": "./dist",
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    // Tests and esbuild.mjs use Node globals and built-in node: modules.
    "types": ["node"],
    // Keep the existing node resolver while TypeScript 6 deprecates its alias.
    "ignoreDeprecations": "6.0",
    "paths": {
      "@webspatial/react-sdk": ["./src"],
      "@webspatial/react-sdk/internal/facades-client": [
        "./src/internal/facades-client.ts"
      ],
      "@webspatial/core-sdk": ["../core/src"],
      "@webspatial/core-sdk/runtime": ["../core/src/runtime/index.ts"]
    }
  },
  "include": ["src", "esbuild.mjs"],
  "references": []
}
